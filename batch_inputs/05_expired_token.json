{
  "name": "05_expired_token",
  "description": "Hard case 2b: an expired token pauses the destination and asks the owner to reconnect.",
  "steps": [
    {
      "method": "POST",
      "path": "/api/v1/connections",
      "body": {
        "connector_key": "ghost",
        "credentials": {
          "admin_api_key": "6489a6f2b8c1d2e3f4a5b6c7:cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd"
        }
      },
      "save_as": "con_g",
      "expect_status": 201
    },
    {
      "method": "POST",
      "path": "/api/v1/destinations",
      "body": {
        "url": "https://ghost-g-{{run}}.mock",
        "connector_key": "ghost",
        "name": "batch ghost g",
        "config": {
          "base_url": "https://ghost-g-{{run}}.mock"
        },
        "audience_tags": [
          "ai",
          "creators"
        ],
        "language": "en",
        "connection_id": "{{con_g.id}}"
      },
      "save_as": "dest_g",
      "expect_status": 201
    },
    {
      "method": "POST",
      "path": "/api/v1/destinations/{{dest_g.id}}/certify",
      "body": {},
      "save_as": "cert_g",
      "expect": {
        "result.passed": true
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/sim/faults",
      "body": {
        "destination_id": "{{dest_g.id}}",
        "kind": "auth_expired",
        "op": "publish"
      },
      "expect_status": 200
    },
    {
      "method": "POST",
      "path": "/api/v1/publications",
      "body": {
        "content": {
          "title": "How we cut video editing time with AI captions",
          "body": "We tested three captioning workflows for short videos and measured the time each one saved.",
          "tags": [
            "ai",
            "video"
          ],
          "promotional": false
        },
        "destination_ids": [
          "{{dest_g.id}}"
        ]
      },
      "headers": {
        "Idempotency-Key": "p-{{run}}"
      },
      "save_as": "p",
      "expect": {
        "result.results.0.error.code": "CONNECTION_AUTH_EXPIRED"
      }
    },
    {
      "method": "GET",
      "path": "/api/v1/destinations/{{dest_g.id}}",
      "expect": {
        "status": "paused"
      }
    }
  ]
}
