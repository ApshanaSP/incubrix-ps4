# Copy to .env and adjust. Every setting the service reads is listed here.
# Nothing here is required for `docker compose up` or for the tests.

# --- service
SERVICE_NAME=incubrix-longtail
PUBLIC_BASE_URL=http://localhost:8080        # base for download links and feed URLs
PORT=8080
DATA_DIR=./data                              # SQLite database and local files
DB_PATH=                                     # optional explicit SQLite path
LOG_LEVEL=INFO
API_TOKEN=                                   # set for the live demo: send "Authorization: Bearer <token>"
RATE_LIMIT_PER_MINUTE=120                    # per client IP; 0 = off

# --- secrets
SECRET_KEY=change-me                         # encrypts stored connection credentials and signs download links
CALLBACK_SECRET=                             # signs job callbacks (X-IncuBrix-Signature); defaults to SECRET_KEY

# --- simulation
SIMULATION_MODE=true                         # all platform calls go to the built-in mock platforms
MOCK_BASE_URL=                               # mock platforms as a separate service (compose: http://mocks:9000)
SEED_DEMO=false                              # seed the demo catalogue even when SIMULATION_MODE=false
CERTIFY_ON_START=true                        # certify newly seeded demo destinations at start-up

# --- outbound calls to platforms
HTTP_TIMEOUT_S=15
MAX_BACKOFF_S=60                             # wait for a 429 reset up to this long, else reschedule
UNAVAILABLE_TRIP_AFTER=5                     # stop calling a destination after N consecutive failures
USER_AGENT=IncuBrixLongTail/1.0 (+https://incubrix.com)
USE_SYSTEM_CERTS=false                       # true = trust the OS certificate store (needs the truststore package)
OWN_DOMAINS=incubrix.com,incubrix.ai         # links to these count as self-promotion

# --- storage (S3-compatible; empty S3_ENDPOINT = local files under DATA_DIR/files)
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=                          # host used in presigned links, if different
S3_BUCKET=incubrix-longtail
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
LINK_TTL_S=604800

# --- jobs
JOB_WORKERS=4

# --- AI providers (adapters; mock needs no key)
AI_PROVIDER=mock                             # mock | groq | gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b               # Apache-2.0 open-weight model
AI_PRICE_PER_M_INPUT=                        # override list prices (USD per million tokens) for cost reports
AI_PRICE_PER_M_OUTPUT=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- catalogue import
REACHABILITY_MODE=online                     # online | offline (skip network checks)
REACHABILITY_CONCURRENCY=50
REACHABILITY_TIMEOUT_S=6
AUDIENCE_TAGS=ai,video,marketing,saas,creators,founders

# --- certification
CLEANUP_DEADLINE_S=600                       # test posts must be gone within this
RECERT_AFTER_DAYS=25                         # re-test before 30 days
RECERT_INTERVAL_S=3600                       # how often the scheduler looks for due destinations
SCHEDULER_ENABLED=true
ALERT_WEBHOOK_URL=                           # receives destination_demoted alerts (tickets are always stored)

# --- docker compose only
GHOST_ADMIN_EMAIL=admin@incubrix.local
GHOST_ADMIN_PASSWORD=Ibx7-qRm2-Wz9k-Lp4v-local     # local test instance only; Ghost rejects simple passwords
LEMMY_ADMIN_USER=incubrix_admin                    # local Lemmy admin from deploy/lemmy/lemmy.hjson
LEMMY_ADMIN_PASSWORD=local-lemmy-admin-only        # local test instance only

# --- command-line tools (batch runner, reviewer check, bootstrap)
API_URL=http://localhost:8080                      # the service the tools call
LEMMY_URL=http://localhost:8536                    # local Lemmy for tools/bootstrap_local.py
GHOST_URL=http://localhost:2368                    # local Ghost for tools/bootstrap_local.py
