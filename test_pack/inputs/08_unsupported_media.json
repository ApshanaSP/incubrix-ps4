{
  "name": "08_unsupported_media",
  "description": "Hard case 3b: media the destination does not accept is dropped with a note; contract validate reports it per field.",
  "steps": [
    {
      "method": "POST",
      "path": "/api/v1/connections",
      "body": {
        "connector_key": "slack",
        "credentials": {
          "bot_token": "xoxb-sim-1111-batch"
        }
      },
      "save_as": "con_m",
      "expect_status": 201
    },
    {
      "method": "POST",
      "path": "/api/v1/destinations",
      "body": {
        "url": "https://slack-m-{{run}}.mock",
        "connector_key": "slack",
        "name": "batch slack m",
        "config": {
          "api_base_url": "https://slack-m-{{run}}.mock",
          "channel": "C0BATCH"
        },
        "audience_tags": [
          "ai",
          "creators"
        ],
        "language": "en",
        "connection_id": "{{con_m.id}}"
      },
      "save_as": "dest_m",
      "expect_status": 201
    },
    {
      "method": "POST",
      "path": "/api/v1/destinations/{{dest_m.id}}/certify",
      "body": {},
      "save_as": "cert_m",
      "expect": {
        "result.passed": true
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/publications",
      "body": {
        "content": {
          "title": "How we cut video editing time with AI captions",
          "body": "We tested three captioning workflows for short videos and measured the time each one saved.",
          "tags": [
            "ai",
            "video"
          ],
          "promotional": false,
          "media": [
            {
              "url": "https://cdn.example.com/a.mp4",
              "type": "video"
            }
          ]
        },
        "destination_ids": [
          "{{dest_m.id}}"
        ]
      },
      "headers": {
        "Idempotency-Key": "p-{{run}}"
      },
      "save_as": "p",
      "expect": {
        "result.results.0.state": "published"
      }
    },
    {
      "method": "POST",
      "path": "/connector/v1/discourse/validate",
      "body": {
        "rendition": {
          "title": "A title that is long enough",
          "body": "Body text long enough here",
          "media": [
            {
              "url": "https://a/b.pdf",
              "type": "file"
            }
          ]
        },
        "destination": {
          "url": "https://x.mock",
          "config": {
            "base_url": "https://x.mock"
          }
        }
      },
      "expect": {
        "ok": false,
        "violations.0.field": "media[0]"
      }
    }
  ]
}
